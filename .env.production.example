# Variables del stack de producción (docker-compose.prod.yml).
# Copia a .env.production, completa los valores y protégelo: chmod 600 .env.production
# Usa contraseñas largas y aleatorias SIN caracteres especiales de URL (@ : / ? #),
# porque algunas se insertan en la URI de MongoDB. Genera una con:
#   openssl rand -hex 24

# ─── Acceso web ───────────────────────────────────────────────
# Cómo se sirve la web:
#   none        Solo HTTP. Para la red local (LAN) del cliente, sin certificados.
#   custom      HTTPS con certificado propio en docker/nginx/certs/server.crt y server.key
#               (p. ej. emitido por la CA corporativa del cliente).
#   letsencrypt HTTPS con Let's Encrypt. Requiere dominio público con DNS apuntando al
#               servidor y el puerto 80 abierto a internet. Define también DOMAIN,
#               CERTBOT_EMAIL y COMPOSE_PROFILES=letsencrypt.
TLS_MODE=none

# URL con la que los usuarios abren la app (http:// o https:// según TLS_MODE).
# Se usa en los enlaces de los correos. La app también funciona si se entra por otra
# IP o nombre del mismo servidor.
PUBLIC_URL=http://192.168.1.50

# ─── Solo para TLS_MODE=letsencrypt ───────────────────────────
# Activa el servicio certbot
#COMPOSE_PROFILES=letsencrypt
# Dominio público (sin https://)
DOMAIN=
# Correo para avisos de expiración de Let's Encrypt
CERTBOT_EMAIL=
# true para usar certificados de prueba mientras configuras (evita los límites de emisión)
CERTBOT_STAGING=false

# ─── Aplicación ───────────────────────────────────────────────
APP_NAME=Automatización
# Mínimo 32 caracteres: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_DB=automatizacion
MONGO_APP_USER=app
MONGO_APP_PASSWORD=

# ─── Mosquitto ────────────────────────────────────────────────
# Usuario con el que el backend se conecta al broker. Debe existir en docker/mosquitto/auth/passwd
MQTT_USER=backend
MQTT_PASSWORD=

# ─── Correo (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true solo para el puerto 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Automatización <no-reply@example.com>"
