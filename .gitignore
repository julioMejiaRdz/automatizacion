# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────
dist/
build/
out/

# ─── Environment variables ───────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test.local
.env.production
.env.production.local

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ──────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Testing ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ────────────────────────────────────────────────────
.cache/
.turbo/
*.local

# ─── Docker / producción ─────────────────────────────────────
# Usuarios, permisos y certificados de Mosquitto (se crean en el servidor)
docker/mosquitto/auth/*
!docker/mosquitto/auth/.gitkeep
docker/mosquitto/certs/*
!docker/mosquitto/certs/.gitkeep
# Certificado propio de Nginx (TLS_MODE=custom)
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep
