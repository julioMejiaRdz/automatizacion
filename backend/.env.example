# ─── Servidor ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL pública del frontend: origen permitido por CORS y base de los enlaces en los correos
FRONTEND_URL=http://localhost:5173
# Número de proxies delante del backend (0 en desarrollo, 1 detrás de Nginx en producción)
TRUST_PROXY=0

# ─── Base de datos (MongoDB) ───────────────────────────────────
DATABASE_URL=mongodb://localhost:27017/automatizacion

# ─── JWT ───────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1d

# ─── MQTT (Mosquitto) ──────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
# Vacíos en desarrollo (el broker local acepta conexiones anónimas)
MQTT_USER=
MQTT_PASSWORD=

# ─── Correo (SMTP) ─────────────────────────────────────────────
# En desarrollo apunta a Mailpit (docker-compose.yml): bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
# true solo para el puerto 465 (TLS implícito); con 587 se usa STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Automatización <no-reply@example.com>"
