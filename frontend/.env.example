# ─── Personalización del proyecto ─────────────────────────────
# Nombre visible de la aplicación (login, sidebar y título de la pestaña)
VITE_APP_NAME=Automatización
# Descripción bajo el nombre en el login (vacío: "Monitoreo en tiempo real")
VITE_APP_DESCRIPTION=
# Logo del cliente: coloca el archivo en frontend/public y escribe su nombre (p. ej. /logo.png).
# Vacío: se muestra un icono genérico. Se ve sobre fondo blanco.
VITE_APP_LOGO=
# Color de marca: cualquier color CSS. Vacío: azul por defecto. Usa un color oscuro o medio:
# el texto encima es blanco. Los hex van ENTRE COMILLAS (sin ellas el # se toma como comentario):
#   VITE_BRAND_COLOR="#185fa5"
VITE_BRAND_COLOR=
# Pie del login; {year} se reemplaza por el año actual. Vacío: sin pie
VITE_FOOTER_TEXT="Desarrollado por COMPRES · {year}"

# ─── Conexión con el backend ──────────────────────────────────
# URL de la API REST del backend (incluye /api)
VITE_API_URL=http://localhost:3000/api
# URL del servidor Socket.IO. Si se deja vacía se usa el mismo origen que sirve el frontend
VITE_WS_URL=http://localhost:3000
